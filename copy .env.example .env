# Copy this file to .env and fill in your keys.
# .env is loaded automatically by config.py via python-dotenv.

# Required for conversational fallback (jarvis/ai/chatbot.py)
OPENAI_API_KEY=

# Optional — required only for the weather skill
OPENWEATHER_API_KEY=

# Optional — required only for the news skill
NEWSAPI_API_KEY=

# Optional overrides (defaults shown)
JARVIS_WAKE_WORD=jarvis
JARVIS_MODEL=gpt-4o-mini
JARVIS_TEMPERATURE=0.6
JARVIS_MAX_TOKENS=512
JARVIS_STT_ENGINE=google
JARVIS_TTS_ENGINE=pyttsx3
JARVIS_TTS_RATE=175
JARVIS_TTS_VOLUME=1.0
JARVIS_DEFAULT_CITY=London
JARVIS_DEFAULT_NEWS_COUNTRY=us
JARVIS_LOG_LEVEL=INFO
